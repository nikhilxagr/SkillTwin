# SkillTwin Unified Environment Configuration
# ========================================================
# BACKEND (Render Web Service Environment Variables)
# ========================================================
NODE_ENV=production
PORT=10000
API_BASE_URL="https://skilltwin-api-hafc.onrender.com"
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skilltwin?retryWrites=true&w=majority"
GEMINI_API_KEY="your-gemini-api-key"
WEB_ORIGIN="https://yourskilltwin.vercel.app"
JWT_SECRET="skilltwin-production-jwt-super-secret-key-2026"
COOKIE_SECRET="skilltwin-cookie-secret-key-2026"

# Nodemailer SMTP Configuration (Gmail, Resend, or SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
EMAIL_FROM="SkillTwin <noreply@skilltwin.dev>"

# ========================================================
# SOCIAL OAUTH AUTHENTICATION (Phase 14)
# ========================================================
# Google Cloud Console: OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://skilltwin-api-hafc.onrender.com/api/auth/google/callback"

# GitHub Developer Settings: OAuth App
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="https://skilltwin-api-hafc.onrender.com/api/auth/github/callback"

# LinkedIn Developer Portal: Sign In with LinkedIn (OpenID Connect)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="https://skilltwin-api-hafc.onrender.com/api/auth/linkedin/callback"

# ========================================================
# FRONTEND (Vercel Project Settings > Environment Variables)
# ========================================================
VITE_API_URL="https://skilltwin-api-hafc.onrender.com"