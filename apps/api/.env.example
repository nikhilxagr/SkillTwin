# SkillTwin Backend API Environment Configuration
PORT=10000
NODE_ENV=production
API_BASE_URL="https://skilltwin-api-hafc.onrender.com"

# Database & AI
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skilltwin?retryWrites=true&w=majority"
GEMINI_API_KEY="your-gemini-api-key"

# CORS & Frontend Origin (Your Vercel deployment URL)
WEB_ORIGIN="https://yourskilltwin.vercel.app"

# Security Secrets (Must be at least 16 characters in production)
JWT_SECRET="skilltwin-production-jwt-super-secret-key-2026"
COOKIE_SECRET="skilltwin-cookie-secret-key-2026"

# Email SMTP Configuration (Nodemailer)
# Gmail: use SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, and a 16-char App Password for SMTP_PASS
# Brevo / SendGrid / Custom SMTP: set corresponding HOST, PORT, USER, and PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
EMAIL_FROM="SkillTwin <noreply@skilltwin.dev>"

# OAuth Credentials & Callbacks (Phase 14)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://skilltwin-api-hafc.onrender.com/api/auth/google/callback"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="https://skilltwin-api-hafc.onrender.com/api/auth/github/callback"

LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="https://skilltwin-api-hafc.onrender.com/api/auth/linkedin/callback"
