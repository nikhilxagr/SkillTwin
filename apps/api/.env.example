# SkillTwin Backend API Environment Configuration
PORT=10000
NODE_ENV=production

# Database & AI
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skilltwin?retryWrites=true&w=majority"
GEMINI_API_KEY="your-gemini-api-key"

# CORS & Frontend Origin (Your Vercel deployment URL)
WEB_ORIGIN="https://your-frontend.vercel.app"

# Security Secrets (Must be at least 16 characters in production)
JWT_SECRET="skilltwin-production-jwt-super-secret-key-2026"
COOKIE_SECRET="skilltwin-cookie-secret-key-2026"
EMAIL_FROM="SkillTwin <noreply@skilltwin.dev>"

